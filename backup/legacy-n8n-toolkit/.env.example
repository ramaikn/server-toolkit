# Contoh isi .env. File .env asli dibuat otomatis oleh install.sh dan TIDAK boleh masuk Git.
POSTGRES_PASSWORD=ganti-dengan-password-kuat
N8N_ENCRYPTION_KEY=ganti-dengan-48-karakter-acak
TZ=Asia/Makassar
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678

